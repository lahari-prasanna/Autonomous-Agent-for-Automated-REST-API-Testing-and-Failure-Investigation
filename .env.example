# ==============================================================================
# Autonomous Agent for REST API Testing & Failure Investigation
# Environment Configuration Template
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# LLM Provider Configuration (Google Gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
# Optional alternative provider:
# OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
# Default: Async SQLite (zero setup required for local development)
DATABASE_URL=sqlite+aiosqlite:///./api_agent.db
# Alternative: PostgreSQL (for production)
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_agent_db

# Security & Sandboxing (SSRF Protection)
# Set to 'true' only to allow testing against localhost mock API during local development
SAFE_DEV_MODE=true
ALLOWED_DEV_HOSTS=localhost,127.0.0.1

# Mock API Configuration
MOCK_API_PORT=8081

# Frontend Configuration (Vite)
VITE_API_BASE_URL=http://localhost:8000
